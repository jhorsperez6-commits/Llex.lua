EnterBtn.MouseButton1Click:Connect(function()
    local inputKey = KeyBox.Text
    if inputKey == "" then
        notify("Escribe una Key")
        return
    end

    notify("Verificando...")
    task.spawn(function()
        local success, onlineKey = pcall(function()
            return game:HttpGet(RAW_KEY_URL)
        end)

        if success and onlineKey then
            onlineKey = onlineKey:gsub("%s+", "") -- Elimina espacios en blanco
            
            if inputKey == onlineKey then
                unlocked = true
                KeyFrame.Visible = false
                notify("¡Key Correcta!")
                openMenu()
            else
                notify("Key Incorrecta")
                KeyBox.Text = ""
            end
        else
            notify("Error al conectar con Pastebin")
        end
    end)
end)

UIS.InputBegan:Connect(function(i, g)
