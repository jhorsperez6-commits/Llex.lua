local function openMenu()
    if not unlocked then 
        KeyFrame.Visible = true 
        return 
    end
    menuOpen = true
    Main.Size = UDim2.new(0, 520, 0, 0)
    Main.Visible = true
    Tween:Create(Main, TweenInfo.new(0.35, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {Size = UDim2.new(0, 520, 0, 360)}):Play()
end

local function closeAll()
    menuOpen = false
    Tween:Create(Main, TweenInfo.new(0.25, Enum.EasingStyle.Quart, Enum.EasingDirection.In), {Size = UDim2.new(0, 520, 0, 0)}):Play()
    task.delay(0.25, function()
        Main.Visible = false
    end)
    KeyFrame.Visible = false
