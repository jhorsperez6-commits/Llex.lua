local function createTab(name)
    local page = Instance.new("ScrollingFrame")
    page.Size = UDim2.new(1, 0, 1, 0)
    page.BackgroundTransparency = 1
    page.BorderSizePixel = 0
    page.ScrollBarThickness = 3
    page.ScrollBarImageColor3 = ACCENT
    page.Visible = false
    page.ZIndex = 52
    page.Parent = ContentArea
    tabs[name] = page

    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(1, -12, 0, 32)
    btn.Position = UDim2.new(0, 6, 0, (#tabButtons * 38) + 6)
    btn.BackgroundColor3 = ITEM_BG
    btn.Text = name
    btn.TextColor3 = TEXT_DARK
    btn.Font = Enum.Font.GothamBold
    btn.TextSize = 11
    btn.ZIndex = 52
    btn.Parent = TabSidebar
    Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 6)

    btn.MouseButton1Click:Connect(function()
        for tName, tPage in pairs(tabs) do
            tPage.Visible = (tName == name)
        end
        for _, tBtn in ipairs(tabButtons) do
            tBtn.TextColor3 = TEXT_DARK
            tBtn.BackgroundColor3 = ITEM_BG
        end
        btn.TextColor3 = ACCENT
        btn.BackgroundColor3 = Color3.fromRGB(42, 48, 65)
    end)

    table.insert(tabButtons, btn)
    return page
end

