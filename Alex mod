-- Bucle para eliminar barreras
task.spawn(function()
    while task.wait(0.6) do
        if delGates or delBarriers or delFences then
            for _, obj in ipairs(Workspace:GetDescendants()) do
                if obj:IsA("BasePart") then
                    local n = obj.Name:lower()
                    local pName = obj.Parent and obj.Parent.Name:lower() or ""
                    
                    local isGate = delGates and (n:find("gate") or n:find("puerta") or pName:find("gate"))
                    local isBarrier = delBarriers and (n:find("barrier") or n:find("barrera") or n:find("concrete") or pName:find("barrier"))
                    local isFence = delFences and (n:find("fence") or n:find("reja") or n:find("malla") or pName:find("fence"))
                    
                    if isGate or isBarrier or isFence then
                        obj.CanCollide = false
                        obj.Transparency = 0.7
                    end
                end
            end
        end
    end
end)

